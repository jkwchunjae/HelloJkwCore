@page "/"
@using HelloJkwCore.Components.Account
@inherits JkwPageBase

<PageTitle>HelloJkw</PageTitle>

@if (IsAuthenticated)
{
    <MudText Typo="Typo.h4">안녕하세요, @User!.DisplayName 님.</MudText>
    <AuthorizeView Roles="DiaryWriter">
        <Authorized>
            <MudButton
                Href="diary"
                StartIcon="@Icons.Material.Filled.MenuBook"
                Variant="Variant.Outlined"
                Color="Color.Dark"
            >
                일기장
            </MudButton>
        </Authorized>
    </AuthorizeView>
    
    <AuthorizeView Roles="Kidsnote">
        <Authorized>
            <MudButton
                Href="kidsnote"
                StartIcon="@Icons.Material.Filled.MenuBook"
                Variant="Variant.Outlined"
                Color="Color.Dark"
            >
                하정이 키즈노트
            </MudButton>
        </Authorized>
    </AuthorizeView>
}
else
{
    <MudText Typo="Typo.h4">안녕하세요.</MudText>

    <Login />
}
