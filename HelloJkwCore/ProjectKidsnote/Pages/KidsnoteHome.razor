@page "/kidsnote"
@page "/kidsnote/{ReportId:long}"
@inherits JkwPageBase

<PageTitle>키즈노트</PageTitle>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4 kidsnote-alert">
        @_errorMessage
    </MudAlert>
}

@if (_isBusy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!KidsnoteClient.IsLoggedIn)
{
    <KidsnoteLoginForm
        HasConfiguredAccount="@Options.HasCredentials"
        IsBusy="_isBusy"
        OnLogin="LoginAsync"
        OnLoginWithConfiguredAccount="LoginWithConfiguredAccountAsync" />
}
else if (_myInfo is not null && _selectedChild is not null && _reports is not null)
{
    @if (_selectedReport is not null)
    {
        <KidsnoteReportList
            MyInfo="_myInfo"
            SelectedChild="_selectedChild"
            Report="_selectedReport"
            ReportIndex="_reportIndex"
            CanNavigatePrevious="CanNavigatePrevious"
            CanNavigateNext="CanNavigateNext"
            OnChildSelected="SelectChildAsync"
            OnReportSelected="SelectReportFromCalendar"
            OnPreviousRequested="ShowPreviousReportAsync"
            OnNextRequested="ShowNextReportAsync">
            <HeaderActions>
                <div class="kidsnote-load-all-actions">
                    <MudButton
                        Class="kidsnote-load-all-desktop"
                        OnClick="LoadAllReportsAsync"
                        Variant="Variant.Outlined"
                        Disabled="@_isLoadingAllReports">
                        @LoadAllReportsButtonText
                    </MudButton>
                    <MudTooltip Text="@LoadAllReportsButtonText">
                        <MudIconButton
                            Class="kidsnote-load-all-mobile"
                            Icon="@(_isLoadingAllReports
                                ? Icons.Material.Filled.HourglassTop
                                : _hasLoadedAllReports
                                    ? Icons.Material.Filled.CheckCircle
                                    : Icons.Material.Filled.Download)"
                            OnClick="LoadAllReportsAsync"
                            Disabled="@_isLoadingAllReports"
                            Size="Size.Small"
                            aria-label="@LoadAllReportsButtonText" />
                    </MudTooltip>
                </div>
            </HeaderActions>
        </KidsnoteReportList>
    }
    else if (string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Info">등록된 알림장이 없습니다.</MudAlert>
    }
}
else
{
    <MudButton
        OnClick="LoadInitialDataAsync"
        Variant="Variant.Filled"
        Color="Color.Primary">
        다시 불러오기
    </MudButton>
}
