@page "/kidsnote/{Nicknames}"
@inherits JkwPageBase

<PageTitle>키즈노트</PageTitle>
@if (User is not null)
{
    <KidsnoteTimeline @key="Nicknames" Actor="User" Nicknames="Nicknames" />
}

@code {
    [Parameter] public string Nicknames { get; set; } = "";

    protected override Task OnPageInitializedAsync()
    {
        if (User is null) Navi.NavigateTo("/account/login");
        return Task.CompletedTask;
    }
}
