@page "/kidsnote/manage/family"
@inherits JkwPageBase
@using ProjectKidsnote.Components

<PageTitle>키즈노트 등록</PageTitle>
<div class="family-settings" lang="ko">
    <header class="page-heading">
        <div>
            <h1>우리 가족 키즈노트</h1>
            <p>아이의 알림장을 등록하고 함께 볼 가족을 선택하세요.</p>
        </div>
        <div class="journal" aria-hidden="true">
            <span class="back-cover"></span><span class="front-cover"><MudIcon Icon="@Icons.Material.Outlined.LocalFlorist" /></span>
        </div>
    </header>

    @if (_families.Count > 1)
    {
        <MudSelect T="string" Label="관리할 가족" Variant="Variant.Outlined" Value="@_family?.User.Id"
                   ValueChanged="SwitchAsync" Disabled="_busy">
            @foreach (var family in _families)
            {
                <MudSelectItem Value="@family.User.Id">@FamilyLabel(family)</MudSelectItem>
            }
        </MudSelect>
    }
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="처리 중" />
    }
    @if (_family is not null && !_ready && (!_busy || _family.Auth is null))
    {
        <KidsnoteLoginForm @key="_family.User" OnLogin="ConnectAsync" IsBusy="_busy" />
        @if (_family.Auth?.EncryptedAuthInfo is not null)
        {
            <MudButton OnClick="RetryAsync" Disabled="_busy">저장된 계정으로 다시 연결</MudButton>
        }
    }
    @if (_ready && _family is not null)
    {
        <section aria-labelledby="family-title">
            <h2 id="family-title">가족 설정</h2>
            <div class="family-grid" @key="_family.User">
                <FamilyAccessCard Title="배우자" Description="아이와 가족 설정을 함께 관리해요."
                    Icon="@Icons.Material.Outlined.FavoriteBorder" Tone="rose"
                    Users="_users.Where(u => u.Id != _family.User)" Selection="_family.Partners"
                    Disabled="_busy" Changed="change => ChangeAccessAsync(change, partners: true)" />
                <FamilyAccessCard Title="모든 아이의 열람자" Description="등록한 모든 아이의 알림장을 볼 수 있어요."
                    Icon="@Icons.Material.Outlined.People" Tone="sage"
                    Users="_users" Selection="_family.AllowedList" Disabled="_busy" Changed="change => ChangeAccessAsync(change)" />
            </div>
        </section>

        <section aria-labelledby="children-title">
            <h2 id="children-title">아이 목록 <small>@VisibleChildren.Count()명</small></h2>
            @if (!VisibleChildren.Any())
            {
                <MudAlert Severity="Severity.Info">연결된 계정에 아이가 없습니다.</MudAlert>
            }
            @foreach (var kid in VisibleChildren)
            {
                var registered = _family.Kids.FirstOrDefault(k => k.ChildId == kid.ChildId);
                var panelId = $"kid-settings-{kid.ChildId}";
                var expanded = _editingKid == kid.ChildId;
                <article class="child-card" @key="(_family.User, kid.ChildId)">
                    <div class="child-overview">
                        <div class="identity">
                            <span class="avatar" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.ChildCare" Size="Size.Large" /></span>
                            <div><h3>@kid.Name</h3>
                                <p class="child-status">@(registered is null ? "아직 홈페이지에 등록하지 않았어요." : "이 홈페이지에 등록된 아이입니다.")</p>
                            </div>
                        </div>
                        @if (registered is not null)
                        {
                            <div class="child-actions">
                                <a class="read-link" href="@($"/kidsnote/{registered.NicknameForUrl}/")"><MudIcon Icon="@Icons.Material.Outlined.MenuBook" Size="Size.Small" />알림장 보기</a>
                                <button class="edit-button" type="button" aria-controls="@panelId" aria-expanded="@(expanded ? "true" : "false")"
                                        aria-label="@($"{kid.Name} 등록 설정 {(expanded ? "닫기" : "열기")}")"
                                        @onclick="() => _editingKid = expanded ? null : kid.ChildId">
                                    <MudIcon Icon="@Icons.Material.Outlined.Settings" Size="Size.Small" />@(expanded ? "닫기" : "설정")
                                </button>
                            </div>
                        }
                    </div>
                    @if (registered is null)
                    {
                        <div class="edit-fields">
                            <MudTextField T="string" Label="알림장 주소에 사용할 닉네임" HelperText="영문 소문자와 숫자를 사용할 수 있어요."
                                Variant="Variant.Outlined" Immediate="true" @bind-Value="kid.NicknameForUrl" Disabled="_busy" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(kid.NicknameForUrl))"
                                OnClick="() => RegisterAsync(kid)">@ObjectName(kid.Name) 이 홈페이지에서 조회할 수 있도록 등록하기</MudButton>
                        </div>
                    }
                    else
                    {
                        <div id="@panelId" hidden="@(!expanded)" class="edit-fields">
                            <MudTextField T="string" @key="(_family.Revision, _inputVersion)" Label="알림장 주소에 사용할 닉네임"
                                HelperText="@($"/kidsnote/{registered.NicknameForUrl}/")" Variant="Variant.Outlined"
                                Value="@registered.NicknameForUrl" ValueChanged="name => RenameAsync(kid.ChildId, name)" Disabled="_busy" />
                            <KidsnoteUserPicker Label="@($"{kid.Name} 알림장을 볼 사람")" Users="_users" Selection="registered.AllowedList"
                                Disabled="_busy" Changed="change => ChangeAccessAsync(change, kid.ChildId)" />
                            <div class="remove-action"><MudButton Color="Color.Error" Disabled="_busy"
                                    OnClick="() => UnregisterAsync(kid.ChildId)">등록 해제</MudButton></div>
                        </div>
                    }
                </article>
            }
        </section>
    }
</div>
