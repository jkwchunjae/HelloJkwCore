@page "/kidsnote/manage/family"
@inherits JkwPageBase
@using ProjectKidsnote.Components
@using ProjectKidsnote.Models.Parents
@using ProjectKidsnote.Services
@using ProjectKidsnote.Client
@using ProjectKidsnote.Configuration
@inject KidsnoteFamilies Families
@inject KidsnoteCredentials Credentials
@inject KidsnoteOptions Options
@inject AppUserManager Accounts

<PageTitle>키즈노트 등록</PageTitle>
<MudText Typo="Typo.h5">키즈노트 등록</MudText>
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
@if (_family is not null)
{
    <fieldset disabled="@_busy">
        @if (_families.Count > 1)
        {
            <label>관리할 가족
                <select value="@_family.User.Id" @onchange="SwitchFamily">
                    @foreach (var family in _families)
                    {
                        <option value="@family.User.Id">@FamilyLabel(family)</option>
                    }
                </select>
            </label>
        }
        @if (_family.Auth?.EncryptedAuthInfo is not null)
        {
            <MudButton OnClick="RefreshAsync" Disabled="_busy">연결된 계정에서 아이 목록 불러오기</MudButton>
        }
        <KidsnoteLoginForm OnLogin="ConnectAsync" IsBusy="_busy" />
        <KidsnoteUserPicker Label="배우자" Users="_users.Where(u => u.Id != _family.User)" Selection="_family.Partners" />
        <KidsnoteUserPicker Label="모든 아이의 알림장을 볼 사람" Users="_users" Selection="_family.AllowedList" />
        @foreach (var kid in _choices)
        {
            <div class="my-4" @key="kid.ChildId">
                <label><input type="checkbox" checked="@_selected.Contains(kid.ChildId)"
                              @onchange="e => Select(kid.ChildId, e.Value is true)" /> @kid.Name</label>
                @if (_selected.Contains(kid.ChildId))
                {
                    <MudTextField @bind-Value="kid.NicknameForUrl" Label="URL 닉네임 (영문 소문자·숫자)" />
                    <KidsnoteUserPicker Label="@($"{kid.Name} 알림장을 볼 사람")" Users="_users" Selection="kid.AllowedList" />
                }
            </div>
        }
        <MudButton OnClick="SaveAsync" Disabled="@(_busy || _family.Auth?.EncryptedAuthInfo is null)"
                   Variant="Variant.Filled" Color="Color.Primary">저장</MudButton>
    </fieldset>
}

@code {
    private List<KidsParent> _families = [];
    private KidsParent? _family;
    private IList<AppUser> _users = [];
    private List<Kid> _choices = [];
    private HashSet<long> _selected = [];
    private string? _error;
    private bool _busy;

    protected override async Task OnPageInitializedAsync()
    {
        if (User is null) { Navi.NavigateTo("/account/login"); return; }
        await RunAsync(async () =>
        {
            _families = (await Families.ReadAsync()).Where(p => p.CanManage(User.Id)).ToList();
            if (User.HasRole(UserRole.Kidsnote) && !_families.Any(p => p.User == User.Id))
                _families.Add(new KidsParent { User = User.Id });
            if (_families.Count == 0) throw new InvalidOperationException("가족 설정을 관리할 권한이 없습니다.");
            _users = (await Accounts.GetUsersInRoleAsync("all")).OrderBy(u => u.DisplayName).ToList();
            Edit(_families.FirstOrDefault(p => p.User == User.Id) ?? _families[0]);
        });
    }

    private string FamilyLabel(KidsParent family) =>
        $"{_users.FirstOrDefault(u => u.Id == family.User)?.DisplayName} 가족 ({string.Join(", ", family.Kids.Select(k => k.Name))})";

    private async Task SwitchFamily(ChangeEventArgs e)
    {
        // Reload saved values so switching families discards all unsaved edits together.
        await OnPageInitializedAsync();
        if (_error is null) Edit(_families.Single(p => p.User.Id == e.Value?.ToString()));
    }

    private void Edit(KidsParent family)
    {
        _family = family;
        _choices = [.. family.Kids];
        _selected = family.Kids.Select(k => k.ChildId).ToHashSet();
    }

    private void Select(long id, bool selected)
    {
        if (selected) _selected.Add(id);
        else _selected.Remove(id);
    }

    private Task RefreshAsync() => RunAsync(() => LoadChildrenAsync(
        Credentials.Open(_family!.User, _family.Auth.EncryptedAuthInfo!)));

    private Task ConnectAsync(KidsnoteLoginRequest login) => RunAsync(() => LoadChildrenAsync(login));

    private async Task LoadChildrenAsync(KidsnoteLoginRequest login)
    {
        using var client = new KidsnoteClient(Options);
        await client.LoginAsync(login.UserId, login.Password);
        var info = await client.GetMyInfoAsync();
        var choices = info.Children.Select(child =>
        {
            var existing = _choices.FirstOrDefault(k => k.ChildId == child.Id);
            var center = child.Enrollment.FirstOrDefault(e => e.IsApproved && !e.RemovedChild)
                ?? child.Enrollment.FirstOrDefault();
            return new Kid
            {
                ChildId = child.Id, Name = child.Name, CenterId = center?.CenterId ?? 0,
                NicknameForUrl = existing?.NicknameForUrl ?? "", AllowedList = existing?.AllowedList ?? []
            };
        }).ToList();
        _family!.Auth = new KidsnoteAuth { EncryptedAuthInfo = Credentials.Protect(_family.User, login) };
        _choices = choices;
        _selected.IntersectWith(choices.Select(k => k.ChildId));
    }

    private Task SaveAsync() => RunAsync(async () =>
    {
        _family!.Kids.Clear();
        _family.Kids.AddRange(_choices.Where(k => _selected.Contains(k.ChildId)));
        await Families.SaveAsync(User!, _family);
        Navi.NavigateTo("/", forceLoad: true);
    });

    private async Task RunAsync(Func<Task> action)
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try { await action(); }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        catch (Exception) { _error = "키즈노트 계정 또는 저장소를 확인하고 다시 시도해 주세요."; }
        finally { _busy = false; }
    }
}
