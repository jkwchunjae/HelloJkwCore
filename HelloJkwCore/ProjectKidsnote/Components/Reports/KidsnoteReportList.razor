<div
    class="kidsnote-report-header mb-4">
    <MudText Typo="Typo.h6" Class="kidsnote-heading kidsnote-report-header-title">
        @Title 알림장
    </MudText>
    <MudStack
        Row="true"
        Justify="Justify.Center"
        Spacing="2"
        Class="kidsnote-report-header-navigation">
        <MudButton
            OnClick="OnPreviousRequested"
            Variant="Variant.Outlined"
            Disabled="@(!CanNavigatePrevious)">
            다음
        </MudButton>
        <MudButton
            OnClick="OnNextRequested"
            Variant="Variant.Outlined"
            Disabled="@(!CanNavigateNext)">
            이전
        </MudButton>
        <MudButton
            OnClick="ToggleCalendar"
            Variant="@(_isCalendarOpen ? Variant.Filled : Variant.Outlined)"
            Color="Color.Primary"
            StartIcon="@Icons.Material.Filled.CalendarMonth"
            aria-expanded="@_isCalendarOpen">
            달력
        </MudButton>
    </MudStack>
    <MudStack
        Row="true"
        Justify="Justify.FlexEnd"
        AlignItems="AlignItems.Center"
        Spacing="2"
        Class="kidsnote-report-header-actions">
        @HeaderActions
    </MudStack>
</div>

<MudCollapse Expanded="_isCalendarOpen">
    <KidsnoteReportCalendar
        ReportIndex="ReportIndex"
        SelectedReportId="Reports[0].Id"
        OnReportSelected="OnReportSelected" />
</MudCollapse>

@foreach (var report in Reports)
{
    <KidsnoteReportCard @key="report.Id" Report="report" LoadAdjacentReport="LoadAdjacentReport" />
}

<MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="pb-20">
    <MudButton
        OnClick="OnPreviousRequested"
        Variant="Variant.Outlined"
        Disabled="@(!CanNavigatePrevious)">
        다음
    </MudButton>
    <MudButton
        OnClick="OnNextRequested"
        Variant="Variant.Outlined"
        Disabled="@(!CanNavigateNext)">
        이전
    </MudButton>
</MudStack>

    @code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public List<SingleReport> Reports { get; set; } = [];
    [Parameter, EditorRequired] public KidsnoteReportIndex ReportIndex { get; set; } = null!;
    [Parameter] public bool CanNavigatePrevious { get; set; }
    [Parameter] public bool CanNavigateNext { get; set; }
    [Parameter, EditorRequired] public EventCallback<long> OnReportSelected { get; set; }
    [Parameter, EditorRequired] public EventCallback OnPreviousRequested { get; set; }
    [Parameter, EditorRequired] public EventCallback OnNextRequested { get; set; }
    [Parameter, EditorRequired]
    public Func<long, int, CancellationToken, Task<SingleReport?>>
        LoadAdjacentReport { get; set; } = null!;
    [Parameter] public RenderFragment? HeaderActions { get; set; }

    private bool _isCalendarOpen;

    private void ToggleCalendar()
    {
        _isCalendarOpen = !_isCalendarOpen;
    }
}
