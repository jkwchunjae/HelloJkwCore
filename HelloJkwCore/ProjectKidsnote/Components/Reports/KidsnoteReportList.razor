<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h6" Class="kidsnote-heading">@SelectedChild.Name 알림장</MudText>
    @if (MyInfo.Children.Count > 1)
    {
        <MudMenu Label="자녀 선택" Variant="Variant.Outlined" Size="Size.Small">
            @foreach (var child in MyInfo.Children)
            {
                <MudMenuItem OnClick="@(() => OnChildSelected.InvokeAsync(child.Id))">
                    @child.Name
                </MudMenuItem>
            }
        </MudMenu>
    }
</MudStack>

<MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="mb-4">
    <MudButton
        OnClick="OnPreviousRequested"
        Variant="Variant.Outlined"
        Disabled="@(!CanNavigatePrevious)">
        이전
    </MudButton>
    <MudButton
        OnClick="OnNextRequested"
        Variant="Variant.Outlined"
        Disabled="@(!CanNavigateNext)">
        다음
    </MudButton>
    <MudButton
        OnClick="ToggleCalendar"
        Variant="@(_isCalendarOpen ? Variant.Filled : Variant.Outlined)"
        Color="Color.Primary"
        StartIcon="@Icons.Material.Filled.CalendarMonth"
        aria-expanded="@_isCalendarOpen">
        달력
    </MudButton>
</MudStack>

<MudCollapse Expanded="_isCalendarOpen">
    <KidsnoteReportCalendar
        ReportIndex="ReportIndex"
        SelectedReportId="Report.Id"
        OnReportSelected="OnReportSelected" />
</MudCollapse>

<KidsnoteReportCard Report="Report" />

<MudStack Row="true" Justify="Justify.Center" Spacing="2">
    <MudButton
        OnClick="OnPreviousRequested"
        Variant="Variant.Outlined"
        Disabled="@(!CanNavigatePrevious)">
        이전
    </MudButton>
    <MudButton
        OnClick="OnNextRequested"
        Variant="Variant.Outlined"
        Disabled="@(!CanNavigateNext)">
        다음
    </MudButton>
</MudStack>

@code {
    [Parameter, EditorRequired] public UserInfo MyInfo { get; set; } = null!;
    [Parameter, EditorRequired] public Child SelectedChild { get; set; } = null!;
    [Parameter, EditorRequired] public SingleReport Report { get; set; } = null!;
    [Parameter, EditorRequired] public KidsnoteReportIndex ReportIndex { get; set; } = null!;
    [Parameter] public bool CanNavigatePrevious { get; set; }
    [Parameter] public bool CanNavigateNext { get; set; }
    [Parameter, EditorRequired] public EventCallback<long> OnChildSelected { get; set; }
    [Parameter, EditorRequired] public EventCallback<long> OnReportSelected { get; set; }
    [Parameter, EditorRequired] public EventCallback OnPreviousRequested { get; set; }
    [Parameter, EditorRequired] public EventCallback OnNextRequested { get; set; }

    private bool _isCalendarOpen;

    private void ToggleCalendar()
    {
        _isCalendarOpen = !_isCalendarOpen;
    }
}
